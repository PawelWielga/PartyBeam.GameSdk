{
  "name": "@partybeam/game-sdk",
  "version": "0.1.0-alpha.4",
  "description": "Game-facing PartyBeam Game Contract v1 client and types",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./package-v1": {
      "types": "./src/package-v1.d.ts",
      "import": "./src/package-v1.js"
    },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*",
    "./package-tools": {
      "types": "./src/package-tools.d.ts",
      "import": "./src/package-tools.js"
    }
  },
  "files": [
    "src",
    "fixtures",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "schemas",
    "bin"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tests/tsconfig.json",
    "check": "npm test && npm run typecheck",
    "prove:reflex": "node tools/prove-reflex.mjs",
    "prove:packages": "node tools/prove-packages.mjs",
    "prove:producer": "node tools/prove-producer.mjs"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "bin": {
    "partybeam": "bin/partybeam.mjs"
  }
}
